{
	"info": {
		"_postman_id": "b9f8b658-0a83-46c5-87c8-cd5f9182d8df",
		"name": "test-mule-app",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "24178838"
	},
	"item": [
		{
			"name": "Success Request",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Content-Type is present\", function () {",
							"    pm.response.to.have.header(\"Content-Type\");",
							"});",
							"",
							"pm.test(\"Your test name\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.body).to.eql(\"Hello World !!!\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "clientId",
						"value": "{{clientId}}",
						"type": "text"
					},
					{
						"key": "clientSecret",
						"value": "{{clientSecret}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://{{hostname}}/api/customers",
					"protocol": "https",
					"host": [
						"{{hostname}}"
					],
					"path": [
						"api",
						"customers"
					]
				}
			},
			"response": []
		},
		{
			"name": "Invalid Authentication",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 401\", function () {",
							"    pm.response.to.have.status(401);",
							"});",
							"",
							"pm.test(\"Content-Type is present\", function () {",
							"    pm.response.to.have.header(\"Content-Type\");",
							"});",
							"",
							"pm.test(\"Your test name\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.error).to.eql(\"Invalid Client\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "clientId",
						"value": "{{clientId}}12",
						"type": "text"
					},
					{
						"key": "clientSecret",
						"value": "{{clientSecret}}12",
						"type": "text"
					}
				],
				"url": {
					"raw": "https://{{hostname}}/api/customers",
					"protocol": "https",
					"host": [
						"{{hostname}}"
					],
					"path": [
						"api",
						"customers"
					]
				}
			},
			"response": []
		}
	]
